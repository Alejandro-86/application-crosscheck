# Copy to .env and fill in. .env is gitignored; never commit a real key.
OPENAI_API_KEY=

# Required for any chat call. Use the exact model name from your OpenAI account, and add it to
# prices.toml so costs are tracked.
OPENAI_CHAT_MODEL=

# Optional (defaults shown)
OPENAI_EMBED_MODEL=text-embedding-3-small

# Hard stop: API calls are refused once logged spend (runs/usage.jsonl) reaches this many USD.
MAX_SPEND_USD=10
